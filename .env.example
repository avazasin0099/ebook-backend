# Node Environment
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL / SQLite)
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=avazas_books
DB_USER=postgres
DB_PASSWORD=your_postgres_password
# Set to true for logging SQL queries
DB_LOGGING=false
# Optional SQLite fallback path if PostgreSQL is not used
SQLITE_STORAGE=./database.sqlite

# Security & Authentication
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# Cashfree Payments (Latest API v2023-08-01)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_API_BASE=https://sandbox.cashfree.com/pg
CASHFREE_RETURN_URL=http://localhost:5173/payment-status?order_id={order_id}

# S3-Compatible Object Storage (Private)
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=avazas-books-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=./uploads

# DRM & Licensing
DRM_PROVIDER=AVAZAS_LCP
DRM_MASTER_KEY=generate_a_random_32_byte_hex_key_for_lcp_master_authority
DRM_OFFLINE_DAYS_LIMIT=30
MAX_DEVICES_PER_CUSTOMER=3

# Admin Initial Provisioning
SUPERADMIN_EMAIL=admin@avazas.com
SUPERADMIN_PASSWORD=AdminSecurePass2026!
